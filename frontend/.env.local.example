NEXT_PUBLIC_API_URL=http://localhost:8000

# Feature flag: show the golden-dataset eval numbers strip on the landing page.
# Off by default — the numbers are static (hand-copied from EVALS.md, not live),
# so this is opt-in per deploy rather than always-on. Requires a rebuild to change
# (NEXT_PUBLIC_* vars are inlined at build time, not read at runtime).
NEXT_PUBLIC_SHOW_EVAL_STATS=false
