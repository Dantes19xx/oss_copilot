# Скопируйте в .env и заполните реальными значениями. .env в git не коммитится.

# OpenAI
OPENAI_API_KEY=

# GitHub (fine-grained PAT: contents:read, pull_requests:write, metadata:read)
GITHUB_PERSONAL_ACCESS_TOKEN=

# LangSmith (мониторинг/трейсинг LLM-вызовов)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=oss-copilot

# Деплой
VERCEL_TOKEN=
RAILWAY_TOKEN=
RAILWAY_PROJECT_ID=

# Инфраструктура (локально поднимается в docker-compose)
QDRANT_URL=http://localhost:6333
